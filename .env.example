# Gemini (optional — used only if AI features are enabled)
GEMINI_API_KEY=

# App URL (local or deployed)
APP_URL=http://localhost:3000

# Supabase (required for persisted dashboard + block grid cache)
# Apply migrations 006_grid_cells.sql (+ 007) in the Supabase SQL editor.
# SERVICE_ROLE is required for Refresh → Analyzing (writes grid_cells).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron / refresh job auth (set a long random string; send as Bearer token or x-cron-secret)
CRON_SECRET=change-me-to-a-long-random-string

# Satellite (free, no key): per-block Sentinel-2 NDVI + Landsat LST via Element84 STAC
#   npm run grid:sentinel:pilot   # capital ICT bbox
#   npm run grid:sentinel         # full ICT grid (slow)
#   npm run grid:fast:full && npm run grid:pack
# Optional EE Console paste still works via npm run grid:ingest-ee
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
# GOOGLE_EARTH_ENGINE_PRIVATE_KEY=
