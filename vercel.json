{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "headers": [
    {
      "source": "/grid_cells_pack.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/grid_heat.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/ssr" },
    { "source": "/api/dashboard", "destination": "/api/dashboard" },
    { "source": "/api/grid", "destination": "/api/grid" },
    { "source": "/api/grid-refresh", "destination": "/api/grid-refresh" },
    { "source": "/api/cron/refresh", "destination": "/api/cron/refresh" },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ],
  "functions": {
    "api/dashboard.ts": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,src/types.ts,data/**}"
    },
    "api/grid.ts": {
      "maxDuration": 30,
      "includeFiles": "{lib/**,data/**}"
    },
    "api/grid-refresh.ts": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,data/**}"
    },
    "api/cron/refresh.ts": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,src/types.ts,data/**}"
    },
    "api/ssr.ts": {
      "maxDuration": 60,
      "includeFiles": "{dist/**,lib/**,src/types.ts,src/types/**,data/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 3 * * *"
    }
  ]
}
