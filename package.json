{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:client": "vite build --outDir dist/client",
    "preview": "vite preview --outDir dist/client",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:weather": "tsx scripts/test-weather.ts",
    "test:risk": "tsx lib/riskModel.test.ts",
    "terrain": "tsx scripts/compute-terrain.ts && node scripts/export-terrain-seed.mjs",
    "grid:fast": "tsx scripts/compute-grid-fast.ts",
    "grid:fast:full": "tsx scripts/compute-grid-fast.ts --full",
    "grid:pack": "node scripts/pack-grid.mjs && node scripts/publish-heat.mjs",
    "grid:ingest-ee": "node scripts/ingest-ee-layers.mjs",
    "grid:sentinel": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/sample-sentinel-blocks.ts",
    "grid:sentinel:pilot": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/sample-sentinel-blocks.ts --capital",
    "grid:sentinel:zones": "node --max-old-space-size=4096 ./node_modules/tsx/dist/cli.mjs scripts/sample-sentinel-blocks.ts --pilot",
    "grid:with-sentinel": "npm run grid:sentinel:pilot && tsx scripts/compute-grid-fast.ts --full && node scripts/pack-grid.mjs && node scripts/publish-heat.mjs",
    "grid:pilot": "tsx scripts/compute-grid.ts --pilot",
    "grid:full": "tsx scripts/compute-grid.ts --full",
    "grid:refresh-local": "tsx scripts/refresh-grid-local.ts",
    "refresh": "tsx scripts/refresh-local.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^6.28.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
